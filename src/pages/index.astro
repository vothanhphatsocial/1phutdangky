---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import SearchForm from '../components/SearchForm.astro';
import PostCard from '../components/PostCard.astro';
import '../styles/home.css';

import {
  CATEGORIES,
  articleUrl,
} from '../config/site';

const categoryIcons = {
  bank: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 10h18M5 10v7M9 10v7M15 10v7M19 10v7M3 19h18M12 3l9 5H3l9-5Z"/>
    </svg>
  `,
  card: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"/>
      <path d="M3 10h18M7 15h4"/>
    </svg>
  `,
  cash: `
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="6" width="18" height="12" rx="2"/>
      <circle cx="12" cy="12" r="3"/>
      <path d="M7 9H5v2M17 15h2v-2"/>
    </svg>
  `,
};

const posts = await getCollection(
  'articles',
  ({ data }) => {
    if (import.meta.env.PROD) {
      return data.draft !== true;
    }

    return true;
  }
);

const sortedPosts = [...posts].sort(
  (a, b) =>
    b.data.updatedAt.valueOf() -
    a.data.updatedAt.valueOf()
);

const featuredPosts = sortedPosts
  .filter((post) => post.data.featured)
  .slice(0, 6);

const latestPosts = sortedPosts.slice(0, 6);
---

<BaseLayout
  title="Hướng dẫn tài chính online"
  description="Hướng dẫn tài chính dễ hiểu về tài khoản ngân hàng, thẻ tín dụng và khoản vay."
>
  <section class="hero">
    <div class="container">
      <div class="hero-stage">
        <div class="hero-copy">
          <p class="eyebrow">1 Phút Đăng Ký</p>

          <h1>
            Hướng dẫn tài chính
            <span>dễ hiểu, dễ thực hiện.</span>
          </h1>

          <p class="hero-description">
            Tìm hiểu tài khoản ngân hàng,
            thẻ tín dụng và khoản vay
            với thông tin rõ ràng, có cấu trúc
            và dễ tra cứu.
          </p>

          <SearchForm
            id="search-input"
            action="/tim-kiem/"
          />
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="visual-glow visual-glow--one"></div>
          <div class="visual-glow visual-glow--two"></div>

          <div class="visual-card-cluster">
            <div class="visual-card visual-card--main">
              <div class="visual-card-head">
                <div class="visual-card-brand">
                  <strong>1 Phút</strong>
                  <span>Đăng Ký</span>
                </div>

                <div class="visual-card-flow" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </div>
              </div>

              <p>Hiểu trước khi chọn</p>

              <div class="visual-steps">
                <span><i>01</i> Cách hoạt động</span>
                <span><i>02</i> Điều kiện &amp; chi phí</span>
                <span><i>03</i> Nguồn cần kiểm tra</span>
              </div>
            </div>

            <div class="visual-note visual-note--top">
              <span></span>
              Thông tin rõ ràng
            </div>
          </div>

          <div class="visual-note visual-note--bottom">
            <span></span>
            Dễ tra cứu
          </div>
        </div>
      </div>

      <div class="principle-strip" aria-label="Nguyên tắc nội dung">
        <span><strong>01</strong> Có cấu trúc</span>
        <span><strong>02</strong> Rõ nguồn</span>
        <span><strong>03</strong> Dễ thực hiện</span>
      </div>
    </div>
  </section>

  <section class="section category-section">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <p class="section-label">Chuyên mục</p>
          <h2>Khám phá theo nhu cầu</h2>
        </div>

        <p>
          Chọn nhóm thông tin phù hợp
          với việc bạn đang cần thực hiện.
        </p>
      </div>

      <div class="category-grid">
        {
          Object.values(CATEGORIES).map((category, index) => (
            <a
              class:list={[
                'category-panel',
                `category-panel--${category.slug}`,
              ]}
              href={`/${category.slug}/`}
            >
              <span class="category-index">
                {String(index + 1).padStart(2, '0')}
              </span>

              <div
                class="category-icon"
                set:html={
                  categoryIcons[
                    category.icon as keyof typeof categoryIcons
                  ]
                }
              />

              <div class="category-content">
                <h3>{category.name}</h3>
                <p>{category.description}</p>

                <span class="category-action">
                  Khám phá
                  <span aria-hidden="true">↗</span>
                </span>
              </div>

              <span class="category-orbit" aria-hidden="true"></span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section featured-section">
    <div class="container">
      <div class="section-heading section-heading--dark">
        <p class="section-label">Bắt đầu từ đây</p>
        <h2>Hướng dẫn nổi bật</h2>
        <p>
          Những nội dung đáng chú ý
          được lựa chọn từ các chuyên mục.
        </p>
      </div>

      {
        featuredPosts.length > 0 ? (
          <div class="featured-grid">
            {
              featuredPosts.map((post) => (
                <PostCard post={post} tone="dark" />
              ))
            }
          </div>
        ) : (
          <p class="featured-empty">
            Chưa có bài nổi bật.
          </p>
        )
      }
    </div>
  </section>

  <section class="section discovery-section">
    <div class="container">
      <div class="discovery-stage">
        <div class="discovery-copy">
          <p class="section-label">Trước khi đăng ký</p>

          <h2>
            Hiểu sản phẩm trước khi
            đưa ra lựa chọn.
          </h2>

          <p>
            1 Phút Đăng Ký tập trung vào
            điều kiện, chi phí, cách hoạt động
            và những điểm cần lưu ý trước khi
            bạn chuyển sang nhà cung cấp.
          </p>

          <a class="button button--primary" href="/mo-tai-khoan/">
            Xem các chuyên mục
          </a>
        </div>

        <div class="discovery-visual" aria-hidden="true">
          <div class="decision-card decision-card--back">
            <span>Điều kiện</span>
            <i></i><i></i><i></i>
          </div>

          <div class="decision-card decision-card--front">
            <span>Trước khi chọn</span>
            <strong>Đọc → Hiểu → Kiểm tra</strong>
            <div><i></i><i></i><i></i></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section latest-section">
    <div class="container latest-layout">
      <div class="section-heading latest-heading">
        <p class="section-label">Nội dung</p>
        <h2>Mới cập nhật</h2>
        <p>
          Các bài được sắp xếp theo
          thời điểm cập nhật gần nhất.
        </p>
      </div>

      <div class="latest-list">
        {
          latestPosts.map((post) => {
            const category = CATEGORIES[post.data.category];

            return (
              <a href={articleUrl(post.id)} class="latest-row">
                <time datetime={post.data.updatedAt.toISOString()}>
                  {
                    post.data.updatedAt.toLocaleDateString(
                      'vi-VN',
                      {
                        day: '2-digit',
                        month: '2-digit',
                      }
                    )
                  }
                </time>

                <div>
                  <span>{category.name}</span>
                  <strong>{post.data.title}</strong>
                </div>

                <span class="latest-arrow" aria-hidden="true">↗</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section trust-section">
    <div class="container">
      <div class="trust-stage">
        <div class="trust-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 3 5 6v5c0 4.5 2.8 8.2 7 10 4.2-1.8 7-5.5 7-10V6l-7-3Z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>

        <div class="trust-copy">
          <p class="section-label">Cách chúng tôi làm nội dung</p>
          <h2>Rõ nguồn trước khi cần đẹp.</h2>

          <p>
            Nội dung tài chính được định hướng
            đối chiếu với nguồn chính thức,
            ghi nhận ngày kiểm tra và cập nhật
            khi thông tin sản phẩm thay đổi.
          </p>

          <a href="/quy-trinh-bien-tap/">
            Xem quy trình biên tập
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <p class="site-disclaimer">
        Thông tin trên website nhằm mục đích
        cung cấp thông tin và có thể thay đổi.
        Hãy kiểm tra điều kiện chính thức
        của nhà cung cấp trước khi đăng ký.
      </p>
    </div>
  </section>
</BaseLayout>
