---
import Header
  from '../components/Header.astro';

import Footer
  from '../components/Footer.astro';

import AnalyticsBridge
  from '../components/AnalyticsBridge.astro';

import ConsentBanner
  from '../components/ConsentBanner.astro';

import JsonLd
  from '../components/JsonLd.astro';

import '../styles/global.css';

import {
  SITE,
} from '../config/site';


interface Props {
  title?: string;

  appendSiteNameToTitle?: boolean;

  description?: string;

  canonical?: string | false;

  noindex?: boolean;

  robots?:
    | 'index, follow'
    | 'noindex, follow'
    | 'noindex, nofollow';

  ogType?: 'website' | 'article';

  publishedTime?: Date;

  modifiedTime?: Date;

  socialImage?: string;

  socialImageAlt?: string;

  socialImageWidth?: number;

  socialImageHeight?: number;

  structuredData?:
    | Record<string, unknown>
    | Record<string, unknown>[];
}


const {
  title,
  appendSiteNameToTitle = true,
  description = SITE.description,
  canonical,
  noindex = false,
  robots,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  socialImage = SITE.socialImage,
  socialImageAlt =
    `${SITE.name} — ${SITE.description}`,
  socialImageWidth = 1200,
  socialImageHeight = 630,
  structuredData,
} = Astro.props;


const pageTitle =
  title
    ? (
        appendSiteNameToTitle
          ? `${title} | ${SITE.name}`
          : title
      )
    : SITE.name;


const canonicalUrl =
  canonical === false
    ? null
    : (
        canonical ??
        new URL(
          Astro.url.pathname,
          SITE.url
        ).toString()
      );


/*
 * Local development luôn noindex.
 *
 * Production chỉ noindex khi page
 * chủ động truyền noindex=true.
 */
const effectiveNoindex =
  import.meta.env.DEV ||
  noindex;


const effectiveRobots =
  robots ??
  (
    effectiveNoindex
      ? 'noindex, nofollow'
      : 'index, follow'
  );


const isHome =
  Astro.url.pathname === '/';


const organizationId =
  `${SITE.url}/#organization`;

const websiteId =
  `${SITE.url}/#website`;


const organizationLogoUrl =
  new URL(
    SITE.logo,
    SITE.url
  ).toString();


const socialImageUrl =
  new URL(
    socialImage,
    SITE.url
  ).toString();


/*
 * Không khai báo address/telephone
 * cho tới khi dữ liệu thật tồn tại.
 */
const homeStructuredData = {
  '@context': 'https://schema.org',

  '@graph': [
    {
      '@type': 'Organization',

      '@id': organizationId,

      name: SITE.name,

      url: `${SITE.url}/`,

      description:
        SITE.description,

      logo: {
        '@type': 'ImageObject',

        url: organizationLogoUrl,

        width: 512,

        height: 512,
      },
    },

    {
      '@type': 'WebSite',

      '@id': websiteId,

      url: `${SITE.url}/`,

      name: SITE.name,

      alternateName: [
        '1phutdangky.com',
      ],

      description:
        SITE.description,

      inLanguage: 'vi-VN',

      publisher: {
        '@id': organizationId,
      },
    },
  ],
};


const pageStructuredData =
  structuredData
    ? (
        Array.isArray(structuredData)
          ? structuredData
          : [structuredData]
      )
    : [];


const allStructuredData = [
  ...(isHome
    ? [homeStructuredData]
    : []),

  ...pageStructuredData,
];
---

<!doctype html>

<html lang="vi">

  <head>

    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <meta name="format-detection" content="telephone=no" />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f6f0" />

    <!-- Theme preference: chạy trước CSS để tránh flash sai theme. -->
    <script is:inline>
      let savedTheme = null;

      try {
        savedTheme =
          localStorage.getItem('1pd-theme-v1');
      } catch {
        // Dùng prefers-color-scheme khi storage không khả dụng.
      }

      const resolvedTheme =
        savedTheme === 'dark' ||
        (
          savedTheme !== 'light' &&
          window.matchMedia(
            '(prefers-color-scheme: dark)'
          ).matches
        )
          ? 'dark'
          : 'light';

      if (
        savedTheme === 'light' ||
        savedTheme === 'dark'
      ) {
        document.documentElement.dataset.theme =
          savedTheme;
      }

      const browserSurface =
        resolvedTheme === 'dark'
          ? '#090a0f'
          : '#f8f6f0';

      document.documentElement.style.backgroundColor =
        browserSurface;

      document.querySelector(
        'meta[name="theme-color"]'
      )?.setAttribute(
        'content',
        browserSurface
      );
    </script>

    <!-- Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      window.gtag =
        window.gtag ||
        function gtag() {
          window.dataLayer.push(arguments);
        };

      let savedConsent = null;

      try {
        savedConsent =
          localStorage.getItem('1pd-consent-v1');
      } catch {
        savedConsent = null;
      }

      const defaultConsent =
        savedConsent === 'granted'
          ? 'granted'
          : 'denied';

      if (
        savedConsent === 'granted' ||
        savedConsent === 'denied'
      ) {
        document.documentElement.dataset
          .consentChoice = savedConsent;
      }

      window.gtag(
        'consent',
        'default',
        {
          ad_storage: defaultConsent,
          ad_user_data: defaultConsent,
          ad_personalization: defaultConsent,
          analytics_storage: defaultConsent,
          wait_for_update: 500,
        }
      );
    </script>

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({
          'gtm.start': new Date().getTime(),
          event: 'gtm.js',
        });

        const firstScript =
          d.getElementsByTagName(s)[0];
        const tag = d.createElement(s);
        const dataLayerQuery =
          l !== 'dataLayer' ? '&l=' + l : '';

        tag.async = true;
        tag.src =
          'https://www.googletagmanager.com/gtm.js?id=' +
          i +
          dataLayerQuery;

        firstScript.parentNode.insertBefore(
          tag,
          firstScript
        );
      })(
        window,
        document,
        'script',
        'dataLayer',
        'GTM-NXX3GHJ7'
      );
    </script>

    <link
      rel="icon"
      href="/favicon.svg?v=20260815"
      type="image/svg+xml"
    />

    <link
      rel="alternate icon"
      href="/favicon.ico?v=20260815"
      sizes="32x32"
    />

    <link
      rel="apple-touch-icon"
      href="/apple-touch-icon.png?v=20260815"
      sizes="180x180"
    />

    <title>
      {pageTitle}
    </title>


    <meta
      name="description"
      content={description}
    />


    <meta
      name="robots"
      content={effectiveRobots}
    />

    {
      canonicalUrl && (
        <link
          rel="canonical"
          href={canonicalUrl}
        />
      )
    }


    <link
      rel="sitemap"
      href="/sitemap-index.xml"
    />


    <!-- Open Graph -->

    <meta
      property="og:title"
      content={pageTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    {
      canonicalUrl && (
        <meta
          property="og:url"
          content={canonicalUrl}
        />
      )
    }

    <meta
      property="og:type"
      content={ogType}
    />

    <meta
      property="og:site_name"
      content={SITE.name}
    />

    <meta
      property="og:locale"
      content="vi_VN"
    />

    <meta
      property="og:image"
      content={socialImageUrl}
    />

    <meta
      property="og:image:alt"
      content={socialImageAlt}
    />

    <meta
      property="og:image:width"
      content={socialImageWidth}
    />

    <meta
      property="og:image:height"
      content={socialImageHeight}
    />


    {
      ogType === 'article' &&
      publishedTime && (

        <meta
          property="article:published_time"
          content={
            publishedTime.toISOString()
          }
        />

      )
    }


    {
      ogType === 'article' &&
      modifiedTime && (

        <meta
          property="article:modified_time"
          content={
            modifiedTime.toISOString()
          }
        />

      )
    }


    <!-- Basic social fallback -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={pageTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={socialImageUrl}
    />

    <meta
      name="twitter:image:alt"
      content={socialImageAlt}
    />


    {
      allStructuredData.length > 0 && (

        <JsonLd
          data={allStructuredData}
        />

      )
    }

  </head>


  <body>

    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NXX3GHJ7"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <ConsentBanner />

    <Header />

    <main data-pagefind-body={effectiveRobots.includes('noindex') ? undefined : true}>
      <slot />
    </main>

    <Footer />

    <AnalyticsBridge />

  </body>

</html>
