<section
  id="consent-banner"
  class="consent-banner"
  role="dialog"
  aria-label="Lựa chọn quyền riêng tư"
  aria-describedby="consent-description"
>
  <div class="consent-inner">
    <div class="consent-copy">
      <strong>Quyền riêng tư và cookie</strong>

      <p id="consent-description">
        Chúng tôi sử dụng công nghệ đo lường và quảng cáo để
        hiểu cách website được sử dụng, cải thiện nội dung và
        đo lường hiệu quả. Bạn có thể chấp nhận hoặc từ chối.
      </p>

      <a href="/chinh-sach-bao-mat/">
        Xem chính sách bảo mật
      </a>
    </div>

    <div class="consent-actions">
      <button
        type="button"
        class="consent-reject"
        data-consent-reject
      >
        Từ chối
      </button>

      <button
        type="button"
        class="consent-accept"
        data-consent-accept
      >
        Chấp nhận tất cả
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const STORAGE_KEY = '1pd-consent-v1';

    const banner =
      document.getElementById('consent-banner');

    if (!banner) {
      return;
    }

    const acceptButton =
      banner.querySelector('[data-consent-accept]');

    const rejectButton =
      banner.querySelector('[data-consent-reject]');

    function readChoice() {
      try {
        return localStorage.getItem(STORAGE_KEY);
      } catch {
        return null;
      }
    }

    function saveChoice(value) {
      try {
        localStorage.setItem(STORAGE_KEY, value);
      } catch {
        // Nếu localStorage bị chặn,
        // consent vẫn được áp dụng cho phiên hiện tại.
      }
    }

    function closeBanner() {
      banner.hidden = true;
    }

    function openBanner() {
      delete document.documentElement.dataset
        .consentChoice;
      banner.hidden = false;
    }

    function updateConsent(value) {
      const consentState =
        value === 'granted'
          ? 'granted'
          : 'denied';

      window.gtag?.(
        'consent',
        'update',
        {
          ad_storage: consentState,
          ad_user_data: consentState,
          ad_personalization: consentState,
          analytics_storage: consentState,
        }
      );

      document.documentElement.dataset
        .consentChoice = consentState;

      if (consentState === 'granted') {
        window.__1pdLoadGtm?.();
      }
    }

    acceptButton?.addEventListener(
      'click',
      () => {
        saveChoice('granted');
        updateConsent('granted');
        closeBanner();
      }
    );

    rejectButton?.addEventListener(
      'click',
      () => {
        saveChoice('denied');
        updateConsent('denied');
        closeBanner();
      }
    );

    document.addEventListener(
      'click',
      (event) => {
        const target = event.target;

        if (!(target instanceof Element)) {
          return;
        }

        const settingsTrigger =
          target.closest('[data-consent-settings]');

        if (!settingsTrigger) {
          return;
        }

        event.preventDefault();
        openBanner();
      }
    );

    const savedChoice = readChoice();

    if (savedChoice === 'granted') {
      closeBanner();
      return;
    }

    if (savedChoice === 'denied') {
      closeBanner();
      return;
    }

    openBanner();


  })();
</script>

<style>
