<script>
  import { clickTrackingPayload } from '../utils/tracking.mjs';
  type TrackingEvent = Record<string, unknown>;

  const trackingWindow = window as typeof window & {
    dataLayer?: TrackingEvent[];
  };

  trackingWindow.dataLayer =
    trackingWindow.dataLayer || [];

  function handleTrackedClick(event: MouseEvent) {
    const target = event.target;

    if (!(target instanceof Element)) {
      return;
    }

    const link =
      target.closest<HTMLAnchorElement>(
        'a[data-event]'
      );

    if (!link) {
      return;
    }

    const payload = clickTrackingPayload(link, window.location.pathname,
      document.documentElement.dataset.consentChoice);
    if (payload) trackingWindow.dataLayer?.push(payload);
  }

  document.addEventListener(
    'click',
    handleTrackedClick
  );
</script>
