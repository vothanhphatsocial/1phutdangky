---
import type { CollectionEntry } from 'astro:content';
import ArticleTitleVisual from './article/ArticleTitleVisual.astro';
import { CATEGORIES, articleUrl } from '../config/site';

interface Props {
  post: CollectionEntry<'articles'>;
  tone?: 'default' | 'dark';
}

const {
  post,
  tone = 'default',
} = Astro.props;

const category = CATEGORIES[post.data.category];
const date = post.data.updatedAt ?? post.data.publishedAt;
---

<article class="post-card" data-tone={tone}>
  <a class="post-link" href={articleUrl(post.id)}>

    <div class="post-visual">
      <ArticleTitleVisual post={post} variant="card" />
    </div>

    <div class="post-body">

      <p class="post-category">
        {category.name}
      </p>

      <h3>{post.data.title}</h3>

      <p class="post-description">
        {post.data.description}
      </p>

      <div class="post-meta">
        <time datetime={date.toISOString()}>
          {
            date.toLocaleDateString('vi-VN', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
            })
          }
        </time>

        {
          post.data.readingMinutes && (
            <span>{post.data.readingMinutes} phút đọc</span>
          )
        }
      </div>

    </div>

  </a>
</article>

<style>
  .post-card {
    overflow: hidden;
    height: 100%;
  }

  .post-card[data-tone="dark"] {
    background: transparent;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .post-visual {
    container-type: inline-size;
  }

  .post-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1rem 0.25rem 0;
  }

  .post-category {
    margin-bottom: 0.35rem;
    color: var(--color-accent-cobalt-strong);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-body h3 {
    margin-bottom: 0.55rem;
    font-size: 1.05rem;
    line-height: 1.35;
  }

  [data-tone="dark"] .post-body h3 {
    color: #f8f5ef;
  }

  .post-description {
    margin-bottom: 1rem;
    color: var(--color-muted);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  [data-tone="dark"] .post-description {
    color: #aaa8a2;
  }

  [data-tone="dark"] .post-category {
    color: #91a8ff;
  }

  [data-tone="dark"] .post-meta {
    color: #7f7e85;
  }

  [data-tone="dark"] .post-link:hover h3 {
    color: #b9c6ff;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: auto;
    color: var(--color-subtle);
    font-size: 0.72rem;
  }

  .post-link:hover h3 {
    color: var(--color-accent-cobalt-strong);
  }
</style>
