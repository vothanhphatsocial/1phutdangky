---
interface Props {
  articleId: string;

  title: string;

  categoryName: string;

  categorySlug: string;

  categoryUrl: string;

  authorName: string;

  authorUrl: string;

  publishedAt: Date;

  updatedAt: Date;

  readingMinutes?: number;
}

const {
  articleId,
  title,
  categoryName,
  categorySlug,
  categoryUrl,
  authorName,
  authorUrl,
  publishedAt,
  updatedAt,
  readingMinutes,
} = Astro.props;

const isLiobankArticle =
  articleId ===
  'the-tin-dung/mo-the-tin-dung-liobank';

const formatDate = (
  date: Date
) =>
  date.toLocaleDateString(
    'vi-VN',
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }
  );
---

<header class:list={[
  'article-header',
  `article-header--${categorySlug}`,
  isLiobankArticle &&
    'article-header--liobank',
]}>

  <nav
    class="breadcrumbs"
    aria-label="Breadcrumb"
  >

    <a href="/">
      Trang chủ
    </a>

    <span aria-hidden="true">
      ›
    </span>

    <a href={categoryUrl}>
      {categoryName}
    </a>

  </nav>


  <div class="article-title-block">

    <img
      class="article-title-mark"
      src="/brand/mark.png?v=20260923-r2"
      alt=""
      width="265"
      height="292"
      aria-hidden="true"
    />

    <div class="article-title-copy">

      <h1>
        {title}
      </h1>

    </div>

  </div>


  <div class="article-meta">

    <span>
      Biên tập và chịu trách nhiệm nội dung:
      {' '}
      <a class="article-author" href={authorUrl}>
        <strong>
          {authorName}
        </strong>
      </a>
    </span>


    <span>
      Cập nhật:
      {' '}
      <time
        datetime={
          updatedAt.toISOString()
        }
      >
        {formatDate(updatedAt)}
      </time>
    </span>


    {
      readingMinutes && (

        <span>
          {readingMinutes} phút đọc
        </span>

      )
    }

  </div>


  {
    publishedAt.valueOf() !==
      updatedAt.valueOf() && (

      <div class="published-date">
        Xuất bản:
        {' '}
        {formatDate(publishedAt)}
      </div>

    )
  }

</header>


<style>
  .article-header {
    color: #0b0c10;
  }


  .article-author {
    color: inherit;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }


  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.45rem;

    margin-bottom: 1rem;

    color: var(--color-muted);

    font-size: 0.8rem;
  }


  .breadcrumbs a {
    color: inherit;

    text-decoration: none;
  }


  .article-header h1 {
    max-width: 760px;
    margin-bottom: 0;
    color: currentColor;

    font-size:
      clamp(
        2.4rem,
        5.7vw,
        5rem
      );
    line-height: 0.98;
    letter-spacing: -0.06em;
  }


  .article-title-block {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: block;

    min-height: clamp(300px, 32vw, 390px);
    padding: clamp(2rem, 6vw, 4.75rem);
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #99c3ff, #92f1d1);
    border-radius: var(--radius-2xl);
  }


  .article-title-copy {
    position: relative;
    z-index: 1;
    min-width: 0;
    max-width: 760px;
  }


  .article-title-mark {
    position: absolute;
    right: clamp(2rem, 6vw, 4.5rem);
    bottom: clamp(1.5rem, 5vw, 3.5rem);
    z-index: 0;
    width: clamp(5rem, 11vw, 7rem);
    height: auto;
    object-fit: contain;
  }


  .article-header--mo-tai-khoan .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #8fb0ff 0%, #c4abff 56%, #a9e8d4 100%);
  }


  .article-header--the-tin-dung .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.7), transparent 25%),
      linear-gradient(135deg, #ffc29e, #f7e88c);
  }


  .article-header--liobank .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #a5c7ff 0%, #b8a5ff 50%, #88ebca 100%);
  }


  .article-header--vay-tien-mat .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.68), transparent 25%),
      linear-gradient(135deg, #b4a3ff, #f1b8f8);
  }


  .article-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 0.55rem 1rem;

    margin-top: 1rem;

    color: var(--color-muted);

    font-size: 0.82rem;
  }


  .article-meta strong {
    color: var(--color-heading);

    font-weight: 650;
  }


  .published-date {
    margin-top: 0.35rem;

    color: var(--color-subtle);

    font-size: 0.75rem;
  }


  @media (max-width: 859px) {
    .article-title-block {
      min-height: auto;
      border-radius: var(--radius-xl);
    }

    .article-title-copy {
      padding-right: 3.5rem;
    }

    .article-title-mark {
      top: 1.5rem;
      right: 1.5rem;
      bottom: auto;
      width: 2.8rem;
    }
  }


  @media (max-width: 479px) {
    .article-title-block {
      padding: 2rem;
    }

    .article-title-copy {
      padding-right: 2.75rem;
    }

    .article-title-mark {
      top: 1.25rem;
      right: 1.25rem;
      width: 2.55rem;
    }

    .article-header h1 {
      font-size: clamp(2.35rem, 10.5vw, 3.05rem);
    }
  }
</style>
