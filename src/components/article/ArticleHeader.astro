---
interface Props {
  articleId: string;

  title: string;

  categoryName: string;

  categorySlug: string;

  categoryUrl: string;

  authorName: string;

  authorUrl: string;

  publishedAt: Date;

  updatedAt: Date;

  readingMinutes?: number;
}

const {
  articleId,
  title,
  categoryName,
  categorySlug,
  categoryUrl,
  authorName,
  authorUrl,
  publishedAt,
  updatedAt,
  readingMinutes,
} = Astro.props;

const isLiobankArticle =
  articleId ===
  'the-tin-dung/mo-the-tin-dung-liobank';

const formatDate = (
  date: Date
) =>
  date.toLocaleDateString(
    'vi-VN',
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }
  );
---

<header class:list={[
  'article-header',
  `article-header--${categorySlug}`,
  isLiobankArticle &&
    'article-header--liobank',
]}>

  <nav
    class="breadcrumbs"
    aria-label="Breadcrumb"
  >

    <a href="/">
      Trang chủ
    </a>

    <span aria-hidden="true">
      ›
    </span>

    <a href={categoryUrl}>
      {categoryName}
    </a>

  </nav>


  <div class="article-title-block">

    <div class="article-title-copy">

      <p class="article-kicker">
        Hướng dẫn · {categoryName}
      </p>

      <h1>
        {title}
      </h1>

    </div>

    <div class="article-visual" aria-hidden="true">

      <div class="article-visual-head">
        <div class="article-visual-brand">
          <strong>1 Phút</strong>
          <span>Đăng Ký</span>
        </div>

        <div class="article-visual-flow" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </div>
      </div>

      <div class="article-visual-line">
        <i>01</i>
        <span></span>
      </div>

      <div class="article-visual-line">
        <i>02</i>
        <span></span>
      </div>

      <div class="article-visual-line">
        <i>03</i>
        <span></span>
      </div>

    </div>

  </div>


  <div class="article-meta">

    <span>
      Biên tập và chịu trách nhiệm nội dung:
      {' '}
      <a class="article-author" href={authorUrl}>
        <strong>
          {authorName}
        </strong>
      </a>
    </span>


    <span>
      Cập nhật:
      {' '}
      <time
        datetime={
          updatedAt.toISOString()
        }
      >
        {formatDate(updatedAt)}
      </time>
    </span>


    {
      readingMinutes && (

        <span>
          {readingMinutes} phút đọc
        </span>

      )
    }

  </div>


  {
    publishedAt.valueOf() !==
      updatedAt.valueOf() && (

      <div class="published-date">
        Xuất bản:
        {' '}
        {formatDate(publishedAt)}
      </div>

    )
  }

</header>


<style>
  .article-header {
    color: #0b0c10;
  }


  .article-author {
    color: inherit;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }


  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.45rem;

    margin-bottom: 1rem;

    color: var(--color-muted);

    font-size: 0.8rem;
  }


  .breadcrumbs a {
    color: inherit;

    text-decoration: none;
  }


  .article-header h1 {
    max-width: 760px;
    margin-bottom: 0;
    color: currentColor;

    font-size:
      clamp(
        2.4rem,
        5.7vw,
        5rem
      );
    line-height: 0.98;
    letter-spacing: -0.06em;
  }


  .article-title-block {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: grid;
    grid-template-columns:
      minmax(0, 1fr)
      minmax(10rem, 13rem);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 3rem);

    min-height: clamp(400px, 42vw, 490px);
    padding: clamp(2rem, 6vw, 4.75rem);
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #99c3ff, #92f1d1);
    border-radius: var(--radius-2xl);
  }


  .article-title-copy {
    position: relative;
    z-index: 1;
    align-self: center;
    min-width: 0;
  }


  .article-header--mo-tai-khoan .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #8fb0ff 0%, #c4abff 56%, #a9e8d4 100%);
  }


  .article-header--the-tin-dung .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.7), transparent 25%),
      linear-gradient(135deg, #ffc29e, #f7e88c);
  }


  .article-header--liobank .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.72), transparent 25%),
      linear-gradient(135deg, #a5c7ff 0%, #b8a5ff 50%, #88ebca 100%);
  }


  .article-header--vay-tien-mat .article-title-block {
    background:
      radial-gradient(circle at 86% 18%, rgba(255, 255, 255, 0.68), transparent 25%),
      linear-gradient(135deg, #b4a3ff, #f1b8f8);
  }


  .article-kicker {
    position: relative;
    z-index: 1;
    margin-bottom: 1rem;
    color: currentColor;
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }


  .article-visual {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 1.35rem;
    color: #f8f5ef;
    background: #0b0c10;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 1.65rem;
    box-shadow: 0 28px 65px rgba(11, 12, 16, 0.22);
    transform: rotate(5deg);
  }


  .article-visual-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }


  .article-visual-brand {
    display: grid;
    line-height: 1;
  }


  .article-visual-brand strong {
    font-size: 1.05rem;
    font-weight: 850;
    letter-spacing: -0.03em;
  }


  .article-visual-brand span {
    margin-top: 0.3rem;
    color: #aaa9b2;
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }


  .article-visual-flow {
    display: grid;
    justify-items: end;
    gap: 0.2rem;
    width: 3.5rem;
    transform: rotate(-7deg);
  }


  .article-visual-flow i {
    display: block;
    height: 0.3rem;
    border-radius: 999px;
  }


  .article-visual-flow i:nth-child(1) {
    width: 58%;
    background: #315cf5;
  }


  .article-visual-flow i:nth-child(2) {
    width: 78%;
    background: #a48cff;
  }


  .article-visual-flow i:nth-child(3) {
    width: 100%;
    background: #6fe0b4;
  }


  .article-visual-line {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
  }


  .article-visual-line i {
    color: #91a8ff;
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 800;
  }


  .article-visual-line span {
    height: 0.5rem;
    background: rgba(255, 255, 255, 0.14);
    border-radius: 999px;
  }


  .article-visual-line:nth-child(3) span {
    width: 78%;
  }


  .article-visual-line:nth-child(4) span {
    width: 58%;
  }


  .article-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 0.55rem 1rem;

    margin-top: 1rem;

    color: var(--color-muted);

    font-size: 0.82rem;
  }


  .article-meta strong {
    color: var(--color-heading);

    font-weight: 650;
  }


  .published-date {
    margin-top: 0.35rem;

    color: var(--color-subtle);

    font-size: 0.75rem;
  }


  @media (max-width: 859px) {
    .article-title-block {
      grid-template-columns: 1fr;
      gap: 2.5rem;

      min-height: auto;
      border-radius: var(--radius-xl);
    }

    .article-visual {
      justify-self: end;
      width: clamp(10rem, 40vw, 13rem);
    }
  }


  @media (max-width: 479px) {
    .article-title-block {
      padding: 2rem;
    }

    .article-header h1 {
      font-size: clamp(2.35rem, 10.5vw, 3.05rem);
    }
  }
</style>
