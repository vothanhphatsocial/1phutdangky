---
import type { CollectionEntry } from 'astro:content';
import ArticleTitleVisual from './ArticleTitleVisual.astro';

interface Props {
  post: CollectionEntry<'articles'>;

  categoryName: string;

  categoryUrl: string;

  authorName: string;

  authorUrl: string;

  publishedAt: Date;

  updatedAt: Date;

  readingMinutes?: number;
}

const {
  post,
  categoryName,
  categoryUrl,
  authorName,
  authorUrl,
  publishedAt,
  updatedAt,
  readingMinutes,
} = Astro.props;

const formatDate = (
  date: Date
) =>
  date.toLocaleDateString(
    'vi-VN',
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    }
  );
---

<header class="article-header">

  <nav
    class="breadcrumbs"
    aria-label="Breadcrumb"
  >

    <a href="/">
      Trang chủ
    </a>

    <span aria-hidden="true">
      ›
    </span>

    <a href={categoryUrl}>
      {categoryName}
    </a>

  </nav>


  <ArticleTitleVisual post={post} variant="hero" />


  <div class="article-meta">

    <span>
      Biên tập và chịu trách nhiệm nội dung:
      {' '}
      <a class="article-author" href={authorUrl}>
        <strong>
          {authorName}
        </strong>
      </a>
    </span>


    <span>
      Cập nhật:
      {' '}
      <time
        datetime={
          updatedAt.toISOString()
        }
      >
        {formatDate(updatedAt)}
      </time>
    </span>


    {
      readingMinutes && (

        <span>
          {readingMinutes} phút đọc
        </span>

      )
    }

  </div>


  {
    publishedAt.valueOf() !==
      updatedAt.valueOf() && (

      <div class="published-date">
        Xuất bản:
        {' '}
        {formatDate(publishedAt)}
      </div>

    )
  }

</header>


<style>
  .article-header {
    color: #0b0c10;
  }


  .article-author {
    color: inherit;
    text-decoration-color: currentColor;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }


  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;

    gap: 0.45rem;

    margin-bottom: 1rem;

    color: var(--color-muted);

    font-size: 0.8rem;
  }


  .breadcrumbs a {
    color: inherit;

    text-decoration: none;
  }


  .article-meta {
    display: flex;
    flex-wrap: wrap;

    gap: 0.55rem 1rem;

    margin-top: 1rem;

    color: var(--color-muted);

    font-size: 0.82rem;
  }


  .article-meta strong {
    color: var(--color-heading);

    font-weight: 650;
  }


  .published-date {
    margin-top: 0.35rem;

    color: var(--color-subtle);

    font-size: 0.75rem;
  }


</style>
