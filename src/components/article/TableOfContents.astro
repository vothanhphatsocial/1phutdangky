---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

const visibleHeadings = headings.filter(
  (heading) =>
    heading.depth === 2 ||
    heading.depth === 3
);
---

{
  visibleHeadings.length > 0 && (

    <details class="toc">

      <summary>
        <span>Nội dung bài viết</span>
        <span class="toc-symbol" aria-hidden="true">+</span>
      </summary>

      <nav aria-label="Mục lục bài viết">

        <ol>

          {
            visibleHeadings.map((heading) => (

              <li
                class:list={[
                  heading.depth === 3 && 'toc-sub',
                ]}
              >

                <a href={`#${heading.slug}`}>
                  {heading.text}
                </a>

              </li>

            ))
          }

        </ol>

      </nav>

    </details>

  )
}

<style>
  .toc {
    margin: 0;

    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .toc summary {
    display: flex;
    align-items: center;
    justify-content: space-between;

    min-height: 58px;

    padding: 0.85rem 0;

    color: var(--color-heading);

    font-size: 0.88rem;
    font-weight: 800;

    cursor: pointer;
    list-style: none;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc-symbol {
    display: grid;
    place-items: center;

    width: 28px;
    height: 28px;

    background: var(--color-heading);
    color: var(--color-bg);

    border-radius: 50%;

    font-size: 0.9rem;
  }

  .toc nav {
    padding: 0 0 1rem;
  }

  .toc ol {
    margin: 0;
    display: grid;
    gap: 0.55rem;

    padding-left: 0;

    list-style: none;
  }

  .toc li {
    margin-bottom: 0;

    font-size: 0.85rem;
  }

  .toc-sub {
    padding-left: 1rem;
  }

  .toc a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;

    color: var(--color-muted);
    text-decoration: none;
  }


  .toc a::before {
    content: '↗';

    color: var(--color-accent-cobalt-strong);

    font-size: 0.7rem;
  }

  .toc a:hover {
    color: var(--color-accent-cobalt-strong);
  }
</style>
