---
interface Props {
  items: string[];
  title?: string;
  variant?: 'default' | 'warning';
}

const {
  items,
  title,
  variant = 'default',
} = Astro.props;
---

<section
  class:list={[
    'checklist',
    `checklist--${variant}`,
  ]}
>

  {
    title && (
      <h3>{title}</h3>
    )
  }

  <div class="checklist-grid">

    {
      items.map((item) => (

        <div class="checklist-item">

          <span aria-hidden="true">
            {
              variant === 'warning'
                ? '!'
                : '✓'
            }
          </span>

          <p>{item}</p>

        </div>

      ))
    }

  </div>

</section>

<style>
  .checklist {
    margin: clamp(2.5rem, 6vw, 4rem) 0;
    padding: 1.4rem 0;

    border-top: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
  }


  .checklist--warning {
    border-color: color-mix(
      in srgb,
      var(--color-accent-coral) 36%,
      var(--color-border)
    );
  }


  .checklist h3 {
    margin: 0 0 1.5rem;

    font-size: clamp(1.1rem, 3vw, 1.35rem);
    letter-spacing: -0.025em;
  }


  .checklist-grid {
    display: grid;
    gap: 0 2.25rem;
  }


  .checklist-item {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    align-items: start;
    gap: 0.8rem;

    padding: 0.9rem 0;

    border-top: 1px solid var(--color-border);
  }


  .checklist-item > span {
    display: grid;
    place-items: center;

    width: 22px;
    height: 22px;

    margin-top: 0.08rem;

    background: var(--color-info-soft);
    color: var(--color-accent-cobalt-strong);

    border-radius: 50%;

    font-size: 0.62rem;
    font-weight: 900;
  }


  .checklist--warning .checklist-item > span {
    background: var(--color-warning-soft);
    color: var(--color-accent-coral);
  }


  .checklist-item p {
    margin: 0;

    color: var(--color-heading);

    font-size: 0.9rem;
    line-height: 1.62;
  }


  @media (min-width: 680px) {
    .checklist-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
