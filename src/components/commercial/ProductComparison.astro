---
import type {
  CollectionEntry,
} from 'astro:content';

import AffiliateCTA
  from './AffiliateCTA.astro';

interface Props {
  products:
    CollectionEntry<'products'>[];

  title?: string;
}

const {
  products,
  title = 'So sánh nhanh',
} = Astro.props;

const labels = Array.from(
  new Set(
    products.flatMap(
      (product) =>
        product.data.facts.map(
          (fact) => fact.label
        )
    )
  )
);

function findValue(
  product:
    CollectionEntry<'products'>,
  label: string
) {
  return (
    product.data.facts.find(
      (fact) =>
        fact.label === label
    )?.value ?? '—'
  );
}
---

<section class="comparison">

  <h2>{title}</h2>

  <div class="table-scroll">

    <table>

      <thead>

        <tr>

          <th scope="col">
            Tiêu chí
          </th>

          {
            products.map(
              (product) => (

                <th scope="col">
                  {product.data.name}
                </th>

              )
            )
          }

        </tr>

      </thead>

      <tbody>

        {
          labels.map((label) => (

            <tr>

              <th scope="row">
                {label}
              </th>

              {
                products.map(
                  (product) => (

                    <td>
                      {
                        findValue(
                          product,
                          label
                        )
                      }
                    </td>

                  )
                )
              }

            </tr>

          ))
        }

      </tbody>

    </table>

  </div>


  <div class="comparison-actions">

    {
      products.map((product) => (

        <div class="comparison-product">

          <div>

            <strong>
              {product.data.name}
            </strong>

            <span>
              {product.data.provider}
            </span>

          </div>

          <AffiliateCTA
            product={product}
            position="comparison"
          />

        </div>

      ))
    }

  </div>


  <p class="comparison-note">
    Thông tin có thể thay đổi.
    Kiểm tra điều kiện chính thức
    trước khi đăng ký.
  </p>

</section>

<style>
  .comparison {
    margin: 3rem 0;
    padding-block: 2rem;

    border-block: 1px solid var(--color-border);
  }

  .comparison > h2 {
    margin-bottom: 1rem;
  }

  .table-scroll {
    overflow-x: auto;

    margin-bottom: 1.5rem;
  }

  table {
    width: 100%;

    min-width: 600px;

    border-collapse:
      collapse;

    font-size: 0.86rem;
  }

  th,
  td {
    padding: 0.85rem;

    border-bottom:
      1px solid
      var(--color-border);

    text-align: left;

    vertical-align: top;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: 0;
  }

  thead th {
    background: transparent;

    color:
      var(--color-heading);

    font-weight: 800;
  }

  tbody th {
    width: 160px;

    color:
      var(--color-muted);

    font-weight: 700;
  }

  td {
    color:
      var(--color-heading);

    font-weight: 600;
  }

  .comparison-actions {
    display: grid;

    border-top: 1px solid var(--color-border);
  }

  .comparison-product {
    display: grid;

    grid-template-columns:
      minmax(0,1fr)
      auto;

    align-items: center;

    gap: 1.5rem;

    padding-block: 1rem;

    border-bottom: 1px solid var(--color-border);
  }

  .comparison-product > div {
    display: grid;

    gap: 0.15rem;
  }

  .comparison-product strong {
    color:
      var(--color-heading);

    font-size: 0.92rem;
  }

  .comparison-product span {
    color:
      var(--color-muted);

    font-size: 0.75rem;
  }

  .comparison-note {
    margin:
      0.75rem 0 0;

    color:
      var(--color-subtle);

    font-size: 0.7rem;
  }

  @media (max-width: 520px) {
    .comparison-product {
      grid-template-columns: 1fr;

      align-items: stretch;
    }
  }
</style>
